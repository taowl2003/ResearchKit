#!/usr/bin/env python3
"""Run ResearchKit from its source checkout without installation."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / 'core'))
try:
    from researchkit.cli import main
except ModuleNotFoundError as exc:
    if exc.name == 'yaml':
        print('缺少 PyYAML；请在当前 Python 环境安装项目依赖后重试。', file=sys.stderr)
        raise SystemExit(1)
    raise
raise SystemExit(main())
