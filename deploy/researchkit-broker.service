[Unit]
Description=ResearchKit Web submission broker
After=network.target

[Service]
Type=simple
User=researchkit-web
Group=researchkit-web
UMask=0077
RuntimeDirectory=researchkit-web
RuntimeDirectoryMode=0755
ExecStart=/opt/researchkit-web/venv/bin/python -I -m researchkit.web_broker --policy /etc/researchkit-web/policy.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/researchkit-web/submissions /run/researchkit-web

[Install]
WantedBy=multi-user.target
